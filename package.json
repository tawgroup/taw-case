{
  "name": "taw-case",
  "version": "0.9.0",
  "description": "A Case-style, YAML-driven state-machine harness for coding agents (Pi/Claude/Codex). Agents act, the harness verifies with evidence.",
  "type": "module",
  "bin": {
    "taw-case": "./bin/taw-case.js"
  },
  "scripts": {
    "start": "node bin/taw-case.js",
    "check": "node --check bin/taw-case.js"
  },
  "keywords": [
    "pi",
    "agent",
    "state-machine",
    "harness",
    "sub-agents",
    "evidence",
    "ci"
  ],
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
